{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@bidayax/tokens": ["packages/tokens/src/index.ts"],
      "@bidayax/ui": ["packages/ui/src/index.ts"],
      "@bidayax/types": ["packages/types/src/index.ts"],
      "@bidayax/config": ["packages/config/src/index.ts"],
      "@bidayax/config/executives": ["packages/config/executives/index.ts"],
      "@bidayax/config/receptionist": ["packages/config/receptionist/index.ts"],
      "@bidayax/config/tailwind": ["packages/config/tailwind/preset.ts"],
      "@bidayax/card-customization": ["services/card-customization/src/index.ts"],
      "@bidayax/polyglot-receptionist": ["services/polyglot-receptionist/src/index.ts"]
    }
  }
}
