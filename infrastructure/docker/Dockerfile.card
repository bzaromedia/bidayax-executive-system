FROM node:24-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/card/package.json apps/card/package.json
COPY packages packages
COPY services/card-customization services/card-customization
COPY services/telemetry services/telemetry
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/card apps/card
RUN pnpm --filter @bidayax/card build

FROM base AS runner
ENV NODE_ENV=production
COPY --from=build /app /app
COPY downloads downloads
EXPOSE 3000
CMD ["pnpm", "--filter", "@bidayax/card", "start"]

