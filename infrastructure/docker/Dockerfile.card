FROM node:22.17.0-alpine AS base
WORKDIR /app
RUN npm install --global pnpm@12.3.4 && pnpm --version

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/card/package.json apps/card/package.json
COPY packages packages
COPY services/card-customization services/card-customization
COPY services/polyglot-receptionist services/polyglot-receptionist
COPY services/telemetry services/telemetry
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/card apps/card
RUN pnpm --filter @bidayax/card build

FROM base AS runner
ENV NODE_ENV=production
COPY --chown=node:node --from=build /app /app
COPY --chown=node:node downloads downloads
USER node
EXPOSE 3000
CMD ["pnpm", "--filter", "@bidayax/card", "start"]
