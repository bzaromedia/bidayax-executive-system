FROM node:22.17.0-alpine AS base
WORKDIR /app
RUN npm install --global pnpm@12.3.4 && pnpm --version

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages packages
COPY services/card-customization services/card-customization
COPY services/communications services/communications
COPY services/polyglot-receptionist services/polyglot-receptionist
COPY services/improvement-engine services/improvement-engine
COPY services/telephony services/telephony
COPY services/telemetry services/telemetry
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/dashboard apps/dashboard
RUN pnpm --filter @bidayax/dashboard build

FROM base AS runner
ENV NODE_ENV=production
COPY --chown=node:node --from=build /app /app
USER node
EXPOSE 3001
CMD ["pnpm", "--filter", "@bidayax/dashboard", "start"]
