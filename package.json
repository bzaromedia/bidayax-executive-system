{
  "name": "the-executive-card",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The Executive Card digital executive identity platform.",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "cards:downloads": "node --experimental-strip-types scripts/generate-executive-card-downloads.ts",
    "cards:downloads:verify": "node --experimental-strip-types scripts/verify-executive-card-downloads.ts",
    "dev": "turbo run dev --parallel",
    "db:check": "node --experimental-strip-types scripts/check-db-connection.ts",
    "db:migrations:verify": "node --experimental-strip-types scripts/verify-migrations.ts",
    "improvement:detect": "node --experimental-strip-types scripts/detect-improvement-opportunities.ts",
    "improvement:generate": "node --experimental-strip-types scripts/generate-improvement-candidates.ts",
    "improvement:smoke": "node --experimental-strip-types scripts/improvement-engine-smoke-test.ts",
    "improvement:verify": "node --experimental-strip-types scripts/verify-improvement-engine.ts",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm db:migrations:verify",
    "test:unit": "pnpm test",
    "telemetry:retention": "node --experimental-strip-types scripts/telemetry-retention-check.ts",
    "telemetry:smoke": "node --experimental-strip-types scripts/telemetry-smoke-test.ts",
    "telemetry:verify": "node --experimental-strip-types scripts/verify-telemetry.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm db:migrations:verify",
    "verify:design-governance": "node --experimental-strip-types scripts/verify-design-governance.ts",
    "verify:no-missing-workspaces": "node --experimental-strip-types scripts/verify-no-missing-workspaces.ts",
    "verify:no-placeholders": "node --experimental-strip-types scripts/verify-no-placeholders.ts",
    "verify:observability": "pnpm db:migrations:verify && pnpm telemetry:verify",
    "verify:public-claims": "node --experimental-strip-types scripts/verify-public-claims.ts",
    "verify:production": "node --experimental-strip-types scripts/production-readiness-check.ts",
    "verify:release-scope": "node --experimental-strip-types scripts/verify-release-scope.ts",
    "turbo:build": "turbo run build",
    "turbo:lint": "turbo run lint",
    "turbo:typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter @bidayax/design-system storybook",
    "build:storybook": "pnpm --filter @bidayax/design-system build-storybook",
    "test:settings-persistence:postgres": "node --experimental-strip-types scripts/settings-persistence-postgres-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@storybook/addon-a11y": "^8.6.0",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@types/node": "^22.10.2",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^0.11.0",
    "next": "^15.1.4",
    "pg": "8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.0",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
