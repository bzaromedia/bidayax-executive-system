{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "incremental": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@bidayax/tokens": [
        "../../packages/tokens/src/index.ts"
      ],
      "@bidayax/identity": [
        "../../packages/identity/src/index.ts"
      ],
      "@bidayax/trust": [
        "../../packages/trust/src/index.ts"
      ],
      "@bidayax/types": [
        "../../packages/types/src/index.ts"
      ],
      "@bidayax/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@bidayax/config/tailwind": [
        "../../packages/config/tailwind/preset.ts"
      ],
      "@bidayax/config/receptionist": [
        "../../packages/config/receptionist/index.ts"
      ],
      "@bidayax/polyglot-receptionist": [
        "../../services/polyglot-receptionist/src/index.ts"
      ],
      "@bidayax/card-customization": [
        "../../services/card-customization/src/index.ts"
      ],
      "@bidayax/config": [
        "../../packages/config/src/index.ts"
      ],
      "@bidayax/config/executives": [
        "../../packages/config/executives/index.ts"
      ]
    },
    "esModuleInterop": true,
    "jsx": "preserve"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
